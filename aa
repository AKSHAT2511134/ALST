<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>P.R.O.T.O.N — System Flowcharts</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Share+Tech+Mono&family=Exo+2:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:        #050810;
    --surface:   #0a0f1e;
    --surface2:  #0e1628;
    --cyan:      #00d4ff;
    --cyan-dim:  rgba(0,212,255,0.15);
    --green:     #00e676;
    --green-dim: rgba(0,230,118,0.15);
    --orange:    #ff9100;
    --orange-dim:rgba(255,145,0,0.15);
    --red:       #ff1744;
    --red-dim:   rgba(255,23,68,0.15);
    --yellow:    #ffe600;
    --purple:    #d500f9;
    --text:      #c8d6e5;
    --text-dim:  #5a6a7e;
    --border:    rgba(0,212,255,0.12);
    --glow:      0 0 20px rgba(0,212,255,0.25);
    --glow-strong: 0 0 40px rgba(0,212,255,0.4);
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Exo 2', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── GRID BG ── */
  body::before {
    content:'';
    position:fixed; inset:0;
    background-image:
      linear-gradient(rgba(0,212,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events:none; z-index:0;
  }

  /* ── HEADER ── */
  header {
    position: relative;
    z-index: 10;
    padding: 3rem 2rem 2rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(0,212,255,0.05) 0%, transparent 100%);
  }

  .brand {
    font-family: 'Orbitron', monospace;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: 0.3em;
    color: var(--cyan);
    text-shadow: 0 0 30px rgba(0,212,255,0.6), 0 0 60px rgba(0,212,255,0.2);
    animation: pulse-brand 3s ease-in-out infinite;
  }

  @keyframes pulse-brand {
    0%,100% { text-shadow: 0 0 30px rgba(0,212,255,0.6),0 0 60px rgba(0,212,255,0.2); }
    50%      { text-shadow: 0 0 50px rgba(0,212,255,0.9),0 0 100px rgba(0,212,255,0.4); }
  }

  .brand-sub {
    font-family: 'Share Tech Mono', monospace;
    font-size: clamp(0.65rem, 1.5vw, 0.85rem);
    letter-spacing: 0.2em;
    color: var(--text-dim);
    margin-top: 0.5rem;
  }

  .header-desc {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--text-dim);
    max-width: 600px;
    margin-inline: auto;
    line-height: 1.6;
  }

  /* ── NAV TABS ── */
  .tab-nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem 2rem;
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(5,8,16,0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .tab-btn {
    font-family: 'Orbitron', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.4rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.25s;
  }

  .tab-btn:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    background: var(--cyan-dim);
  }

  .tab-btn.active {
    border-color: var(--cyan);
    background: var(--cyan-dim);
    color: var(--cyan);
    box-shadow: var(--glow);
  }

  /* ── MAIN CONTENT ── */
  .main {
    position: relative;
    z-index: 1;
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .chart-section {
    display: none;
    animation: fadeIn 0.4s ease;
  }
  .chart-section.active { display: block; }

  @keyframes fadeIn {
    from { opacity:0; transform:translateY(8px); }
    to   { opacity:1; transform:translateY(0); }
  }

  .section-title {
    font-family: 'Orbitron', monospace;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--cyan);
    margin-bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title::after {
    content:'';
    flex:1;
    height:1px;
    background: linear-gradient(90deg, var(--cyan), transparent);
  }

  .section-desc {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 2.5rem;
    max-width: 700px;
  }

  /* ── FLOWCHART CANVAS ── */
  .fc-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    overflow-x: auto;
    box-shadow: 0 4px 40px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.04);
  }

  svg.flowchart {
    display: block;
    margin: 0 auto;
    overflow: visible;
  }

  /* ── SHARED SVG CLASSES ── */
  .fc-label {
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    font-weight: 600;
    fill: #c8d6e5;
  }

  .fc-label-sm {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    fill: #5a6a7e;
  }

  .fc-label-mono {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    fill: #00d4ff;
  }

  .node-io       { fill: #0e1628; stroke: #00d4ff; stroke-width: 1.5; }
  .node-process  { fill: #0e1628; stroke: #00d4ff; stroke-width: 1.5; rx: 6; }
  .node-decision { fill: #0f1220; stroke: #ffb800; stroke-width: 1.5; }
  .node-success  { fill: #041a0d; stroke: #00e676; stroke-width: 1.5; }
  .node-danger   { fill: #1a0408; stroke: #ff1744; stroke-width: 1.5; }
  .node-warn     { fill: #1a0d00; stroke: #ff9100; stroke-width: 1.5; }
  .node-dispatch { fill: #0a0520; stroke: #d500f9; stroke-width: 1.5; }
  .node-sensor   { fill: #081118; stroke: #00d4ff; stroke-width: 1.2; }

  .connector { stroke: #00d4ff; stroke-width: 1.5; fill: none; marker-end: url(#arr-cyan); }
  .connector-green { stroke: #00e676; stroke-width: 1.5; fill: none; marker-end: url(#arr-green); }
  .connector-red   { stroke: #ff1744; stroke-width: 1.5; fill: none; marker-end: url(#arr-red); }
  .connector-orange{ stroke: #ff9100; stroke-width: 1.5; fill: none; marker-end: url(#arr-orange); }
  .connector-purple{ stroke: #d500f9; stroke-width: 1.5; fill: none; marker-end: url(#arr-purple); }
  .connector-dash  { stroke: #5a6a7e; stroke-width: 1.2; fill: none; stroke-dasharray: 5,3; marker-end: url(#arr-dim); }

  /* ── GLOW FILTERS ── */
  .glow-cyan   { filter: drop-shadow(0 0 6px rgba(0,212,255,0.5)); }
  .glow-green  { filter: drop-shadow(0 0 6px rgba(0,230,118,0.5)); }
  .glow-red    { filter: drop-shadow(0 0 6px rgba(255,23,68,0.5)); }
  .glow-orange { filter: drop-shadow(0 0 6px rgba(255,145,0,0.5)); }
  .glow-purple { filter: drop-shadow(0 0 6px rgba(213,0,249,0.5)); }

  /* ── LEGEND ── */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.75rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-dim);
  }

  .legend-swatch {
    width: 18px;
    height: 12px;
    border-radius: 2px;
    border: 1px solid;
    flex-shrink: 0;
  }

  /* ── FLOW ANIMATION ── */
  @keyframes dash-flow {
    to { stroke-dashoffset: -20; }
  }

  .animated-path {
    stroke-dasharray: 8 4;
    stroke-dashoffset: 0;
    animation: dash-flow 1.2s linear infinite;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .tab-nav { flex-wrap: wrap; }
    .fc-wrap { padding: 1rem; }
    .main { padding: 1rem; }
  }
</style>
</head>
<body>

<header>
  <div class="brand">P·R·O·T·O·N</div>
  <div class="brand-sub">PREDICTIVE REAL-TIME OBSERVATION &amp; THREAT NEUTRALIZATION</div>
  <div class="header-desc">System Architecture &amp; Operational Flowcharts — AI-powered autonomous emergency response pipeline</div>
</header>

<nav class="tab-nav">
  <button class="tab-btn active" onclick="switchTab('pipeline')">⚡ Detection-to-Dispatch</button>
  <button class="tab-btn" onclick="switchTab('facerecog')">👁 Face Recognition</button>
  <button class="tab-btn" onclick="switchTab('architecture')">🏗 System Architecture</button>
</nav>

<div class="main">

  <!-- ════════════════════════════════════════
       CHART 1: DETECTION-TO-DISPATCH PIPELINE
       ════════════════════════════════════════ -->
  <div class="chart-section active" id="tab-pipeline">
    <div class="section-title">⚡ Detection-to-Dispatch Pipeline</div>
    <div class="section-desc">Full 5-stage operational flow from continuous sensor monitoring to autonomous emergency dispatch. Score must exceed 80, be multi-sensor confirmed, and sustained for 10–15 seconds before alert triggers.</div>

    <div class="fc-wrap">
      <svg class="flowchart" width="860" height="1180" viewBox="0 0 860 1180">
        <defs>
          <!-- Arrow markers -->
          <marker id="arr-cyan"   markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#00d4ff"/></marker>
          <marker id="arr-green"  markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#00e676"/></marker>
          <marker id="arr-red"    markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#ff1744"/></marker>
          <marker id="arr-orange" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#ff9100"/></marker>
          <marker id="arr-purple" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#d500f9"/></marker>
          <marker id="arr-dim"    markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#5a6a7e"/></marker>
          <!-- Glow filters -->
          <filter id="f-cyan"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          <filter id="f-green"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          <!-- Grid pattern -->
          <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M20 0 L0 0 0 20" fill="none" stroke="rgba(0,212,255,0.04)" stroke-width="0.5"/>
          </pattern>
        </defs>

        <!-- Background -->
        <rect width="860" height="1180" fill="url(#grid)" rx="8"/>

        <!-- ─── STAGE LABELS ─── -->
        <text x="20" y="46" class="fc-label-sm" fill="#00d4ff" opacity="0.5" font-family="'Orbitron',monospace" font-size="9" letter-spacing="2">STAGE 1</text>
        <text x="20" y="240" class="fc-label-sm" fill="#00d4ff" opacity="0.5" font-family="'Orbitron',monospace" font-size="9" letter-spacing="2">STAGE 2</text>
        <text x="20" y="440" class="fc-label-sm" fill="#ffb800" opacity="0.5" font-family="'Orbitron',monospace" font-size="9" letter-spacing="2">STAGE 3</text>
        <text x="20" y="600" class="fc-label-sm" fill="#00e676" opacity="0.5" font-family="'Orbitron',monospace" font-size="9" letter-spacing="2">STAGE 4</text>
        <text x="20" y="780" class="fc-label-sm" fill="#d500f9" opacity="0.5" font-family="'Orbitron',monospace" font-size="9" letter-spacing="2">STAGE 5</text>

        <!-- Stage separator lines -->
        <line x1="15" y1="215" x2="845" y2="215" stroke="rgba(0,212,255,0.08)" stroke-width="1" stroke-dasharray="4,4"/>
        <line x1="15" y1="415" x2="845" y2="415" stroke="rgba(255,184,0,0.08)" stroke-width="1" stroke-dasharray="4,4"/>
        <line x1="15" y1="575" x2="845" y2="575" stroke="rgba(0,230,118,0.08)" stroke-width="1" stroke-dasharray="4,4"/>
        <line x1="15" y1="760" x2="845" y2="760" stroke="rgba(213,0,249,0.08)" stroke-width="1" stroke-dasharray="4,4"/>

        <!-- ─── STAGE 1: CONTINUOUS MONITORING ─── -->
        <!-- 4 sensor nodes -->
        <!-- Camera -->
        <rect x="65" y="55" width="130" height="64" rx="6" class="node-sensor" filter="url(#f-cyan)"/>
        <text x="130" y="78" text-anchor="middle" class="fc-label" font-size="11">📷 HD Camera</text>
        <text x="130" y="94" text-anchor="middle" class="fc-label-mono" font-size="10">YOLOv8</text>
        <text x="130" y="108" text-anchor="middle" class="fc-label-sm">Vision Analysis</text>

        <!-- Microphone -->
        <rect x="228" y="55" width="130" height="64" rx="6" class="node-sensor" filter="url(#f-cyan)"/>
        <text x="293" y="78" text-anchor="middle" class="fc-label" font-size="11">🎙 Microphone</text>
        <text x="293" y="94" text-anchor="middle" class="fc-label-mono" font-size="10">CNN-RNN</text>
        <text x="293" y="108" text-anchor="middle" class="fc-label-sm">Audio Analysis</text>

        <!-- Smoke -->
        <rect x="500" y="55" width="130" height="64" rx="6" class="node-sensor" filter="url(#f-cyan)"/>
        <text x="565" y="78" text-anchor="middle" class="fc-label" font-size="11">💨 Smoke Sensor</text>
        <text x="565" y="94" text-anchor="middle" class="fc-label-mono" font-size="10">MQ-2</text>
        <text x="565" y="108" text-anchor="middle" class="fc-label-sm">Environmental</text>

        <!-- Heat -->
        <rect x="665" y="55" width="130" height="64" rx="6" class="node-sensor" filter="url(#f-cyan)"/>
        <text x="730" y="78" text-anchor="middle" class="fc-label" font-size="11">🌡 Heat Sensor</text>
        <text x="730" y="94" text-anchor="middle" class="fc-label-mono" font-size="10">DHT22</text>
        <text x="730" y="108" text-anchor="middle" class="fc-label-sm">Temperature</text>

        <!-- Lines from sensors to AI Processing -->
        <line x1="130" y1="119" x2="130" y2="147" class="connector animated-path"/>
        <line x1="293" y1="119" x2="293" y2="155" class="connector animated-path"/>
        <line x1="565" y1="119" x2="565" y2="155" class="connector animated-path"/>
        <line x1="730" y1="119" x2="730" y2="147" class="connector animated-path"/>

        <!-- Converge lines -->
        <path d="M130,147 Q130,160 430,160" class="connector animated-path"/>
        <path d="M293,155 Q293,165 430,165" class="connector animated-path"/>
        <path d="M565,155 Q565,165 430,165" class="connector animated-path"/>
        <path d="M730,147 Q730,160 430,162" class="connector animated-path"/>

        <!-- ─── STAGE 2: THREAT SCORING ─── -->
        <!-- AI Processing box -->
        <rect x="240" y="165" width="380" height="72" rx="8" class="node-process" filter="url(#f-cyan)"/>
        <text x="430" y="188" text-anchor="middle" class="fc-label" font-size="13" font-weight="700" fill="#00d4ff">🤖 AI Processing Engine</text>
        <text x="430" y="206" text-anchor="middle" class="fc-label-sm" font-size="10">YOLOv8 Vision  •  CNN-RNN Audio  •  DeepFace Recognition</text>
        <text x="430" y="222" text-anchor="middle" class="fc-label-sm" font-size="10">Compute per-frame threat contribution from each input source</text>

        <!-- Arrow down to Threat Score -->
        <line x1="430" y1="237" x2="430" y2="267" class="connector"/>

        <!-- Threat Score -->
        <rect x="240" y="267" width="380" height="72" rx="8" fill="#080d1a" stroke="#ffb800" stroke-width="1.5" filter="url(#f-cyan)"/>
        <text x="430" y="289" text-anchor="middle" class="fc-label" font-size="13" font-weight="700" fill="#ffb800">📊 Dynamic Threat Score</text>
        <text x="430" y="307" text-anchor="middle" class="fc-label-sm" font-size="10">Aggregated weighted score from all active sensors  •  Range: 0 – 100</text>
        <text x="430" y="323" text-anchor="middle" class="fc-label-sm" font-size="10">Color-coded live dashboard:  🟢 Safe  🟡 Moderate  🟠 High  🔴 Critical</text>

        <!-- Score bar illustration -->
        <rect x="295" y="334" width="270" height="8" rx="4" fill="rgba(255,255,255,0.05)" stroke="rgba(255,184,0,0.2)" stroke-width="0.5"/>
        <defs>
          <linearGradient id="score-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="#00e676"/>
            <stop offset="40%"  stop-color="#ffb800"/>
            <stop offset="70%"  stop-color="#ff9100"/>
            <stop offset="100%" stop-color="#ff1744"/>
          </linearGradient>
        </defs>
        <rect x="295" y="334" width="270" height="8" rx="4" fill="url(#score-grad)" opacity="0.7"/>
        <text x="295" y="354" class="fc-label-sm" font-size="9">0</text>
        <text x="400" y="354" text-anchor="middle" class="fc-label-sm" font-size="9">THRESHOLD: 80</text>
        <text x="565" y="354" text-anchor="middle" class="fc-label-sm" font-size="9">100</text>
        <line x1="511" y1="330" x2="511" y2="345" stroke="#ff1744" stroke-width="1.5" stroke-dasharray="2,2"/>

        <!-- Arrow down to multi-sensor check -->
        <line x1="430" y1="361" x2="430" y2="395" class="connector"/>

        <!-- ─── STAGE 3: MULTI-SENSOR CONFIRMATION ─── -->
        <!-- Diamond decision -->
        <polygon points="430,425 570,470 430,515 290,470" fill="#0f1220" stroke="#ffb800" stroke-width="1.5" filter="url(#f-cyan)"/>
        <text x="430" y="461" text-anchor="middle" class="fc-label" font-size="11" fill="#ffb800">Score &gt; 80?</text>
        <text x="430" y="477" text-anchor="middle" class="fc-label-sm" font-size="9">Multi-Sensor Confirmed?</text>
        <text x="430" y="491" text-anchor="middle" class="fc-label-sm" font-size="9">Sustained 10–15 sec?</text>

        <!-- NO path → loop back left -->
        <path d="M290,470 L120,470 L120,200 L240,200" class="connector-red" stroke-dasharray="6,3"/>
        <text x="200" y="460" text-anchor="middle" class="fc-label" font-size="10" fill="#ff1744">NO</text>
        <text x="120" y="370" text-anchor="middle" class="fc-label-sm" font-size="9" transform="rotate(-90,120,370)">CONTINUE MONITORING</text>

        <!-- YES path → down -->
        <line x1="430" y1="515" x2="430" y2="545" class="connector-green"/>
        <text x="445" y="535" class="fc-label" font-size="10" fill="#00e676">YES</text>

        <!-- ─── STAGE 4: BIOMETRIC CANCELLATION ─── -->
        <!-- Alert occupant -->
        <rect x="255" y="545" width="350" height="60" rx="8" fill="#0a1208" stroke="#00e676" stroke-width="1.5"/>
        <text x="430" y="568" text-anchor="middle" class="fc-label" font-size="12" fill="#00e676">🔔 Alert Occupant</text>
        <text x="430" y="585" text-anchor="middle" class="fc-label-sm" font-size="10">Visual + Audio alarm triggered — 30-second cancellation window opens</text>
        <text x="430" y="599" text-anchor="middle" class="fc-label-sm" font-size="9">Biometric verification required to cancel: Face Recognition + Voice Keyword</text>

        <line x1="430" y1="605" x2="430" y2="635" class="connector-green"/>

        <!-- Biometric decision -->
        <polygon points="430,660 570,700 430,740 290,700" fill="#0a100a" stroke="#00e676" stroke-width="1.5"/>
        <text x="430" y="692" text-anchor="middle" class="fc-label" font-size="11" fill="#00e676">Cancellation</text>
        <text x="430" y="708" text-anchor="middle" class="fc-label-sm" font-size="9">received within 30s?</text>

        <!-- YES → Cancel, loop back -->
        <path d="M570,700 L700,700 L700,300 L620,300" class="connector-green" stroke-dasharray="6,3"/>
        <text x="638" y="690" class="fc-label" font-size="10" fill="#00e676">YES</text>
        <text x="700" y="520" text-anchor="middle" class="fc-label-sm" font-size="9" transform="rotate(90,700,520)">FALSE ALARM CANCELLED</text>

        <!-- NO → dispatch -->
        <line x1="430" y1="740" x2="430" y2="770" class="connector-red"/>
        <text x="445" y="760" class="fc-label" font-size="10" fill="#ff1744">NO</text>

        <!-- ─── STAGE 5: AUTONOMOUS DISPATCH ─── -->
        <!-- Identify threat type -->
        <rect x="230" y="770" width="400" height="56" rx="8" fill="#0a0520" stroke="#d500f9" stroke-width="1.5"/>
        <text x="430" y="794" text-anchor="middle" class="fc-label" font-size="12" fill="#d500f9">🔍 Identify Threat Type</text>
        <text x="430" y="812" text-anchor="middle" class="fc-label-sm" font-size="10">Classify: 🔥 Fire  •  🏥 Medical Emergency  •  🚨 Intruder</text>
        <text x="430" y="826" text-anchor="middle" class="fc-label-sm" font-size="9">Assemble Smart Data Package: GPS • Live Feed • Floor Plan • Entry Points</text>

        <line x1="430" y1="826" x2="430" y2="856" class="connector-purple"/>

